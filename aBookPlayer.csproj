<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.12.1</Version>
    <AssemblyTitle>aBookPlayer</AssemblyTitle>
    <Product>aBookPlayer</Product>
    <Company>aBookPlayer</Company>
    <!-- The UI is English-only: skip the framework's localized satellite assemblies -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Installer sources and build output live in installer\ and must not be part of the app; Core\ and Android\
         are projects of their own (the shared library and the Android app) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);installer\**;tests\**;Core\**;Android\**</DefaultItemExcludes>
    <RootNamespace>aBookPlayer</RootNamespace>
    <!-- MediaControls calls WinRT through raw COM vtables (function pointers) instead of the 25 MB SDK projection -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\aBookPlayer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="aBookPlayer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icon (title bar, taskbar, Alt+Tab); the 1024 px PNG is the source artwork -->
    <EmbeddedResource Include="Resources\aBookPlayer.ico" LogicalName="aBookPlayer.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\aBookPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Text to speech (File → Create an audiobook from a text): the managed side of ONNX Runtime only; its native
         library and DirectML are downloaded on demand, like the voices (see SpeechRuntime). The version must match
         SpeechRuntime.OrtVersion. OnnxSharp edits Kokoro's model once, so that it runs on the graphics card -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
    <PackageReference Include="OnnxSharp" Version="0.3.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
