<Project Sdk="Microsoft.NET.Sdk">

	<!-- aBookPlayer for Android (.NET MAUI): the library, playback with Media3 in the background, chapters and
	     subtitles; it shares aBookPlayer.Core with the Windows app and reads the books, subtitles and positions
	     from a folder kept in sync with the PC (Syncthing, FolderSync…). No transcription: the .srt files come
	     from the Windows app. -->
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<!-- Not "aBookPlayer.Android": that namespace would hide Android.* inside the app's own code -->
		<RootNamespace>aBookPlayer.Droid</RootNamespace>
		<AssemblyName>aBookPlayer.Android</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>aBookPlayer</ApplicationTitle>
		<ApplicationId>io.github.marcotrombetta.abookplayer</ApplicationId>
		<!-- The same version as the Windows app (released together); the version code grows with it: 1.11.0 → 11100 -->
		<ApplicationDisplayVersion>1.12.1</ApplicationDisplayVersion>
		<ApplicationVersion>11201</ApplicationVersion>

		<!-- Android 6.0 and later: Media3 (the player) needs API 23; that is nearly every phone in use -->
		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>

		<!-- The settings, the sync files and the download records are JSON read by reflection (in the shared code
		     too): kept working in the trimmed Release build -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<!-- Release: an APK to install from the releases page (not an app bundle), signed with the app's key, given
	     on the command line (AndroidSigningKeyStore, AndroidSigningKeyAlias and the passwords): never in the repository -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidKeyStore>true</AndroidKeyStore>
		<!-- 32-bit phones too (older and cheaper ones), not only the 64-bit ones .NET builds for by default -->
		<RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<!-- The Windows app's artwork: its emblem (without the name) on its slate, as an adaptive icon every launcher can shape -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#2B3140" />
		<MauiSplashScreen Include="..\Resources\aBookPlayer.png" Link="Resources\Splash\splash.png" Color="#16161A" BaseSize="160,160" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\aBookPlayer.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- Media3: ExoPlayer (decoding, speed without pitch change, skip silences, several files as one book) and
		     MediaSession (background playback, notification, lock screen, headset buttons) -->
		<PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.11.1" />
		<PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.11.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Media3 brings newer AndroidX Collection/Lifecycle than MAUI pins: the rest of each family is aligned to
		     them, so no library runs against a mix of versions -->
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" Version="2.11.0.1" />
	</ItemGroup>

</Project>
